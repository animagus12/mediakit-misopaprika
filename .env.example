# Password required to view /invoice-generator and /mediakit-generator
INVOICE_PASSWORD=

# Random secret used to sign the shared session cookie (e.g. `openssl rand -hex 32`)
INVOICE_SESSION_SECRET=

# Upstash Redis (KV) — powers the /mediakit views counter shown on /mediakit-generator.
# Without these set, view counting is skipped silently (counter reads as 0).
KV_REST_API_URL=
KV_REST_API_TOKEN=
