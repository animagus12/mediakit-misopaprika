# Password required to view the dashboard, /invoice-generator, and /mediakit-generator
APP_PASSWORD=

# Random secret used to sign the shared session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Upstash Redis (KV) — required. Stores the media kit draft/published data
# (Vercel's filesystem is read-only, so Save/Publish need this in production)
# and powers the /mediakit views counter. Without these set, view counting is
# skipped silently (counter reads as 0), and Save/Publish fail with an error.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob — required for /mediakit-generator's image pickers (profile
# photo, collab logos, tile covers). Files upload directly from the browser
# to Blob storage; only the resulting URL is saved. Create a Blob store on
# the Vercel project and it's auto-populated there; for local dev, copy the
# token from the Vercel dashboard (Storage > your Blob store > .env.local tab).
BLOB_READ_WRITE_TOKEN=

# Google Sheets — service account (Viewer) on the earnings sheet. Powers the
# dashboard's earnings overview. Create the service account in Google Cloud
# Console (IAM & Admin > Service Accounts), enable the Sheets API, generate a
# JSON key, and share the sheet with the account's email as Viewer.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
EARNINGS_SHEET_ID=
EARNINGS_SHEET_TAB=
