# Password required to view the dashboard, /invoices, and /mediakit-generator
APP_PASSWORD=

# Random secret used to sign the shared session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Upstash Redis (KV) — required. Stores the media kit draft/published data,
# invoices, editor transactions, and campaigns/collaborations (Vercel's
# filesystem is read-only, so all of these need this in production), and
# powers the /mediakit views counter. Without these set, view counting is
# skipped silently (counter reads as 0), and every save/add/edit action
# fails with an error.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob — required for /mediakit-generator's image pickers (profile
# photo, collab logos, tile covers). Files upload directly from the browser
# to Blob storage; only the resulting URL is saved. Create a Blob store on
# the Vercel project and it's auto-populated there; for local dev, copy the
# token from the Vercel dashboard (Storage > your Blob store > .env.local tab).
BLOB_READ_WRITE_TOKEN=

# Secret the scheduled jobs authenticate with. Vercel sends it automatically as
# `Authorization: Bearer <CRON_SECRET>` on every cron invocation; without it
# both refresh routes answer 401. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# Instagram — powers the {instagram_followers} placeholder on /links.
# Requires a Business or Creator account (followers_count is not returned for
# personal ones) and a Meta app with the "Instagram API with Instagram Login"
# product. Put the LONG-LIVED token here; it is only the seed. On its first
# run /api/cron/refresh-instagram copies it into Redis and renews it from
# there, because a refresh mints a new token and the app cannot rewrite its
# own environment. Rotating this variable later has no effect unless the
# `instagram_token` Redis key is deleted first.
INSTAGRAM_ACCESS_TOKEN=
